# Copy to /opt/fieldops/.env on the server. Never commit the real file.

# GitHub Container Registry images (lowercase owner/repo)
GHCR_IMAGE_PREFIX=ghcr.io/your-github-user/fieldopsai
IMAGE_TAG=latest

# Public hostnames — create A records pointing at the server IP
DOMAIN_APP=app.example.com
DOMAIN_API=api.example.com
DOMAIN_GRAFANA=grafana.example.com
# Let's Encrypt folder name (use DOMAIN_APP if you issue one SAN certificate)
CERT_NAME=app.example.com
LETSENCRYPT_EMAIL=you@example.com

# App
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
SEED_DEMO_DATA=false
AUTO_CREATE_TABLES=true
CORS_ORIGINS=https://app.example.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
UPLOAD_DIR=/data/uploads
LOG_LEVEL=INFO

# Database
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=fieldops
DATABASE_URL=postgresql+asyncpg://fieldops:replace-with-a-strong-db-password@postgres:5432/fieldops

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-grafana-password

# Optional: pull private GHCR packages
# GHCR_USERNAME=your-github-user
# GHCR_TOKEN=ghp_xxx

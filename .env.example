# FieldOps AI — copy to .env and adjust.

APP_NAME=FieldOps AI
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# SQLite for local demo; PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://fieldops:fieldops@postgres:5432/fieldops
DATABASE_URL=sqlite+aiosqlite:///./.data/fieldops.db

AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14

# Leave empty to use the deterministic heuristic analyzer (demo still works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_RETRIES=2

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Auto-open a draft work order when risk is CRITICAL.
AUTO_CREATE_WORK_ORDER_ON_CRITICAL=true

PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
